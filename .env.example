# Copie este archivo como .env para correr la ETL en su computador.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# En GitHub Actions estos valores van en Settings > Secrets and variables > Actions.

# --- Secrets ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DATABASE_URL=postgresql://etl_escritura:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Variables (no son secretas) ---
DRIVE_RAIZ_ID=
TABLA_MAESTRA_ID=

# --- Solo para pruebas locales (nunca la base de producción) ---
TEST_DATABASE_URL=
PEI_DATOS_REALES=
